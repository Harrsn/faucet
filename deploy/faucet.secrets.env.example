# Install to /opt/cascade-config/faucet.secrets.env, root-owned, mode 600.
# Read by deploy/stack.yml via env_file. Never commit the real file.
#
# Only SESSION_SECRET belongs here. Everything else the app needs is a
# WIZARD_KEY in config.py and lives in /opt/cascade-config/faucet.env, which is
# loaded over process env and would override anything set here anyway.
#
# Generate:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(48))'

SESSION_SECRET=replace-me
