# ── Faucet ──────────────────────────────────────────────────────────────
# Copy to .env. Only SESSION_SECRET matters up front: connections, paths,
# hunting and everything else are set in the setup wizard and Settings, and
# stored in Faucet's database. Values for those set here are imported ONCE,
# on the first start, then ignored (a startup warning names any it skips).

# Signing key for session cookies — set a long random value so logins
# survive restarts:   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# ── docker-compose ──
# One folder for media AND downloads (see docker-compose.yml for why).
DATA_PATH=./data
PUID=1000
PGID=1000
TZ=Etc/UTC
# Bundled Transmission's web/RPC login (enter the same in the wizard).
CLIENT_USER=faucet
CLIENT_PASS=changeme

# ── Behind a reverse proxy ──
# Whose X-Forwarded-*/CF-* headers to believe. 'auto' = the container's default
# gateway (Docker's port proxy). Unset = trust nobody.
#TRUSTED_PROXIES=auto
#CLIENT_IP_HEADERS=cf-connecting-ip,x-real-ip,x-forwarded-for
#COOKIE_SECURE=auto

# ── Sign-in hardening ──
#SESSION_DAYS=30
#LOGIN_MAX_FAILED=5
#LOGIN_IP_MAX_FAILED=20
#LOGIN_ACCOUNT_MAX_FAILED=50
#LOGIN_LOCK_MINUTES=15
#REGISTER_IP_MAX=5

# ── Operations ──
# Prometheus scrape token for /metrics (or scrape with an admin session).
#METRICS_TOKEN=
# Sorter: auto (default: hardlink, else move, else copy) | move | hardlink | copy
#MEDIASORT_MODE=auto
# How often the download client's transfer list is polled (seconds).
#TRANSFERS_POLL_SECONDS=5
